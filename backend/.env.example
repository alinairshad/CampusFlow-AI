# ── MongoDB Atlas ───────────────────────────────────────────────────────────
# Replace <user>, <password>, <cluster>, and <dbname> with your Atlas values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
DATABASE_NAME=campusflow

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Provider (OpenRouter or compatible OpenAI-format API) ────────────────
LLM_API_KEY=sk-or-your-openrouter-api-key-here
LLM_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
CHAT_MODEL=openai/gpt-4o-mini

# ── University (single fixed value for MVP) ──────────────────────────────────
UNIVERSITY_ID=university_mvp_001

# ── Admin seed (used by scripts/seed_admin.py — never committed as real values) ──
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=changeme1
ADMIN_NAME=System Admin

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
# For development, include localhost. For production, add your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
